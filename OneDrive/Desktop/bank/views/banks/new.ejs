<h1>Add New Bank</h1>

<form action="/banks" method="POST">
  <div>
    <label for="bankCode">Bank Code:</label>
    <input type="text" id="bankCode" name="bankCode" required>
  </div>
  
  <div>
    <label for="bankName">Bank Name:</label>
    <input type="text" id="bankName" name="bankName" required>
  </div>

  <div>
    <label for="headquarters">Headquarters:</label>
    <input type="text" id="headquarters" name="headquarters" required>
  </div>

  <div>
    <label for="numberOfBranches">Number of Branches:</label>
    <input type="number" id="numberOfBranches" name="numberOfBranches" required>
  </div>

  <div>
    <label for="totalAssets">Total Assets:</label>
    <input type="number" id="totalAssets" name="totalAssets" required>
  </div>

  <div>
    <label for="isInternational">Is International:</label>
    <select id="isInternational" name="isInternational" required>
      <option value="true">Yes</option>
      <option value="false">No</option>
    </select>
  </div>

  <div>
    <label for="establishedYear">Established Year:</label>
    <input type="number" id="establishedYear" name="establishedYear" required>
  </div>

  <div>
    <label for="contactEmail">Contact Email:</label>
    <input type="email" id="contactEmail" name="contactEmail" required>
  </div>

  <button type="submit">Add Bank</button>
</form>

<a href="/banks">Back to All Banks</a>
